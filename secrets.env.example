# ============================================================
# ~/.agents/secrets.env — Fill in your actual values.
# This file is gitignored. Never commit secrets.env.
# ============================================================

# --- Context7 ---
CONTEXT7_API_KEY=ctx7sk-YOUR_KEY_HERE

# --- GitHub MCP ---
# Create token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE

# --- Obsidian ---
OBSIDIAN_URL=http://127.0.0.1:27123/mcp/
OBSIDIAN_AUTH_TOKEN=YOUR_OBSIDIAN_BEARER_TOKEN_HERE

# --- MySQL Local ECB ---
MYSQL_LOCAL_ECB_HOST=127.0.0.1
MYSQL_LOCAL_ECB_PORT=3306
MYSQL_LOCAL_ECB_USER=root
MYSQL_LOCAL_ECB_PASSWORD=YOUR_PASSWORD_HERE
MYSQL_LOCAL_ECB_DB=ecb_develop

# --- MySQL Develop ECB ---
MYSQL_DEVELOP_ECB_HOST=aws.connect.psdb.cloud
MYSQL_DEVELOP_ECB_PORT=3306
MYSQL_DEVELOP_ECB_USER=YOUR_USER_HERE
MYSQL_DEVELOP_ECB_PASSWORD=YOUR_PASSWORD_HERE
MYSQL_DEVELOP_ECB_DB=europe-chartered-bank-develop

# --- MySQL Remote JCF ---
MYSQL_REMOTE_JCF_HOST=aws.connect.psdb.cloud
MYSQL_REMOTE_JCF_PORT=3306
MYSQL_REMOTE_JCF_USER=YOUR_USER_HERE
MYSQL_REMOTE_JCF_PASSWORD=YOUR_PASSWORD_HERE
MYSQL_REMOTE_JCF_DB=jcfinance-develop
MYSQL_REMOTE_JCF_SSL=true

# --- MySQL Local Forbes ---
MYSQL_LOCAL_FORBES_HOST=127.0.0.1
MYSQL_LOCAL_FORBES_PORT=13306
MYSQL_LOCAL_FORBES_USER=root
MYSQL_LOCAL_FORBES_PASSWORD=YOUR_PASSWORD_HERE
MYSQL_LOCAL_FORBES_DB=forbes_private_bank
