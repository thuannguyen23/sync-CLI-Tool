# ============================================================
# ~/.agents/secrets.env — Fill in your actual values.
# This file is gitignored. Never commit secrets.env.
# ============================================================

# --- Context7 ---
CONTEXT7_API_KEY=ctx7sk-YOUR_KEY_HERE

# --- MySQL Cloud (PlanetScale / remote) ---
MYSQL_CLOUD_HOST=aws.connect.psdb.cloud
MYSQL_CLOUD_PORT=3306
MYSQL_CLOUD_USER=YOUR_CLOUD_USER
MYSQL_CLOUD_PASSWORD=YOUR_CLOUD_PASSWORD
MYSQL_CLOUD_DB=your-cloud-db-name

# --- MySQL Local ---
MYSQL_LOCAL_HOST=127.0.0.1
MYSQL_LOCAL_PORT=3306
MYSQL_LOCAL_USER=root
MYSQL_LOCAL_PASSWORD=YOUR_LOCAL_PASSWORD
MYSQL_LOCAL_DB=local_db_name
