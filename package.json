{
  "name": "sync-cli-tool",
  "version": "1.0.0",
  "description": "Single Source of Truth for MCP servers, skills, rules, and hooks — automatically synced to AGY, Codex, OpenCode, Cursor, Kilo, Cline, and Claude Code",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "eval": "node scripts/workflow-eval.mjs",
    "test:teardown": "./test-teardown.sh",
    "sync": "node scripts/sync-skills.mjs && node scripts/sync-rules.mjs && node scripts/sync-mcp.mjs && node scripts/sync-hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "handoff": "node scripts/handoff.mjs",
    "health": "node scripts/health-check.mjs",
    "mcp:install": "node scripts/install-host-mcps.mjs",
    "mcp:versions": "node scripts/mcp-versions.mjs",
    "mcp:update": "node scripts/update-mcps.mjs",
    "setup": "./setup.sh",
    "teardown": "./teardown.sh"
  },
  "private": true,
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
