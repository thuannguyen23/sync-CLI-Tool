{
  "servers": {
    "context7": {
      "command": ["npx", "@upstash/context7-mcp@1.0.31"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "requires": ["npx"],
      "description": "Library docs lookup via Context7"
    },
    "sequential-thinking": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "requires": ["npx"],
      "description": "Sequential reasoning / chain-of-thought"
    },
    "codegraph": {
      "command": ["codegraph", "serve", "--mcp"],
      "requires": ["codegraph"],
      "description": "Code intelligence and knowledge graph"
    },
    "mysql-local-ecb": {
      "command": ["uvx", "--from", "mysql-mcp-server", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "${MYSQL_LOCAL_ECB_HOST}",
        "MYSQL_PORT": "${MYSQL_LOCAL_ECB_PORT}",
        "MYSQL_USER": "${MYSQL_LOCAL_ECB_USER}",
        "MYSQL_PASSWORD": "${MYSQL_LOCAL_ECB_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_LOCAL_ECB_DB}"
      },
      "requires": ["uvx"],
      "description": "MySQL MCP — Local ECB database"
    },
    "mysql-develop-ecb": {
      "command": ["uvx", "--from", "mysql-mcp-server", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "${MYSQL_DEVELOP_ECB_HOST}",
        "MYSQL_PORT": "${MYSQL_DEVELOP_ECB_PORT}",
        "MYSQL_USER": "${MYSQL_DEVELOP_ECB_USER}",
        "MYSQL_PASSWORD": "${MYSQL_DEVELOP_ECB_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_DEVELOP_ECB_DB}"
      },
      "requires": ["uvx"],
      "description": "MySQL MCP — Remote ECB/develop database"
    },
    "mysql-remote-jcf": {
      "command": ["uvx", "--from", "mysql-mcp-server", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "${MYSQL_REMOTE_JCF_HOST}",
        "MYSQL_PORT": "${MYSQL_REMOTE_JCF_PORT}",
        "MYSQL_USER": "${MYSQL_REMOTE_JCF_USER}",
        "MYSQL_PASSWORD": "${MYSQL_REMOTE_JCF_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_REMOTE_JCF_DB}",
        "MYSQL_SSL": "${MYSQL_REMOTE_JCF_SSL}"
      },
      "requires": ["uvx"],
      "description": "MySQL MCP — Remote JC Finance database"
    },
    "mysql-local-forbes": {
      "command": ["uvx", "--from", "mysql-mcp-server", "mysql_mcp_server"],
      "env": {
        "MYSQL_HOST": "${MYSQL_LOCAL_FORBES_HOST}",
        "MYSQL_PORT": "${MYSQL_LOCAL_FORBES_PORT}",
        "MYSQL_USER": "${MYSQL_LOCAL_FORBES_USER}",
        "MYSQL_PASSWORD": "${MYSQL_LOCAL_FORBES_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_LOCAL_FORBES_DB}"
      },
      "requires": ["uvx"],
      "description": "MySQL MCP — Local Forbes database"
    },
    "obsidian": {
      "url": "${OBSIDIAN_URL}",
      "headers": {
        "Authorization": "Bearer ${OBSIDIAN_AUTH_TOKEN}"
      },
      "description": "Obsidian vault integration via HTTP/SSE"
    },
    "github": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "requires": ["npx"],
      "description": "Thao tác repository, PRs, Issues trên GitHub"
    },
    "web-search": {
      "command": ["npx", "-y", "@zhafron/mcp-web-search"],
      "requires": ["npx"],
      "description": "Tìm kiếm web (DuckDuckGo, Bing) không cần API key"
    },
    "puppeteer": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "requires": ["npx"],
      "description": "Browser automation, E2E testing, scraping"
    }
  }
}
